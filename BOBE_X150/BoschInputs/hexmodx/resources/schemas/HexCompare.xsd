<xs:schema targetNamespace="www.rbin.com/mds-1" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="www.rbin.com/mds-1" elementFormDefault="qualified">
	<xs:element name="HEXCOMPARE">
		<xs:annotation>
			<xs:documentation>HEXCOMPARE tag is the one which has an attribute called LOG which is used to write o/p xml file.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COMPARE" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="LOG" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>LOG is an optional attribute which is used to write o/p xml file. if LOG is present then only we will write xml file else we don't.
in LOG user has an option to give complete file name e.g (c\temp\hexcompare.xml) or only the o/p directry e.g (c\temp), if we give the later one then Hexmod will write  o/p xml file as HexCompareInfo.xml</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="COMPARE">
		<xs:annotation>
			<xs:documentation>COMPARE tag is unbounded tag which holds the attribute EXIT which tells Hexmod to abort pgm or continue with furthur comparison, if data dosn't match or if any error  occurs</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="RANGE" minOccurs="2" maxOccurs="2"/>
			</xs:sequence>
			<xs:attribute name="EXIT" type="xs:boolean" use="optional" default="false"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="RANGE">
		<xs:annotation>
			<xs:documentation>RANGE is used for specifying the FILENAME, START and the LEN  and TYPE of the hexfile to be compared.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="HEXFILE" type="xs:string" use="required"/>
			<xs:attribute name="START" type="exhexBinary" use="required"/>
			<xs:attribute name="LEN" type="exhexBinary" use="required"/>
			<xs:attribute name="TYPE" type="filetype" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="CONF">
		<xs:annotation>
			<xs:documentation>CONF Tag is the root of all tags.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HEXMOD"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ERRMOD">
		<xs:annotation>
			<xs:documentation>ERRMOD contains information on the logging of messages to log file,logging of messages to console and aborting of the program</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="LOG"/>
				<xs:element ref="MSGLOG" minOccurs="0"/>
				<xs:element ref="MSGCONSOLE" minOccurs="0"/>
				<xs:element ref="PROGABORT" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="HEXMOD">
		<xs:annotation>
			<xs:documentation>Hexmod Tag is the basic tag for all the modules.This tag always comes after CONF tag. It represents the following content is for Hexmod tool to process</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ERRMOD" minOccurs="0"/>
				<xs:element ref="HEXCOMPARE" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="LOG">
		<xs:annotation>
			<xs:documentation>LOG Tag is used to specify the Log file name in the FILE attribute.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="FILE" type="xs:string" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="MSGCONSOLE">
		<xs:annotation>
			<xs:documentation>MSGCONSOLE is the level which has to be logged to the console - 1 stands for INFO,2 stands for WARNING,3 stands for error.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="LVL" type="exLvl" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="MSGLOG">
		<xs:annotation>
			<xs:documentation>MSGLOG is the level which has to be logged to the log file - 1 stands for INFO,2 stands for WARNING,3 stands for error.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="LVL" type="exLvl" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="PROGABORT">
		<xs:annotation>
			<xs:documentation>PROGABORT is the level which exits the program  - 2 stands for WARNING,3 stands for error.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="LVL" type="exLvl2" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="filetype">
		<xs:restriction base="xs:string">
