<xs:schema
    targetNamespace="www.rbin.com/mds-1"
    xmlns="www.rbin.com/mds-1"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    elementFormDefault="qualified">
    <xs:element name="BASEIO">
        <xs:annotation>
            <xs:documentation>BASEIO tag specifies xml file is parsed by BASEIO module. It can have one of the two
                elements, either INPUT or OUTPUT
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:choice>
                    <xs:element ref="INPUT" />
                    <xs:element ref="OUTPUT" />
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="CONF">
        <xs:annotation>
            <xs:documentation>CONF Tag is the root of all tags.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="HEXMOD" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="ERRMOD">
        <xs:annotation>
            <xs:documentation>ERRMOD contains information on the logging of messages to log file,logging of messages to
                console and aborting of the program
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="LOG" />
                <xs:element
                    ref="MSGLOG"
                    minOccurs="0" />
                <xs:element
                    ref="MSGCONSOLE"
                    minOccurs="0" />
                <xs:element
                    ref="PROGABORT"
                    minOccurs="0" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="FILEIN">
        <xs:annotation>
            <xs:documentation>FILEIN Tag is used to read the files specified in the attribute NAME. FROM and LEN have to
                be filled when range of data has to read. OVERWRITE attribute is specified with true or false depending
                on whether they have to be overwritten or not. IGNORELINECKS attribute has to be set to true or false
                depending on whether ignoring is required or not. The TYPE attribute can be either IHEX or S19 or BIN
                files.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element
                    name="COPYFILE"
                    minOccurs="0"
                    maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element
                                name="COPYBLOCK"
                                maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute
                                        name="FROM"
                                        type="eAddr"
                                        use="required" />
                                    <xs:attribute
                                        name="LEN"
                                        type="eAddr"
                                        use="required" />
                                    <xs:attribute
                                        name="TO"
                                        type="eAddr"
                                        use="required" />
                                    <xs:attribute
                                        name="OVERWRITE"
                                        type="xs:string"
                                        use="optional" />
                                    <xs:attribute
                                        name="FILLGAPS"
                                        type="xs:string"
                                        use="optional" />
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute
                            name="TYPE"
                            type="filetype"
                            use="required" />
                        <xs:attribute
                            name="NAME"
                            type="xs:string"
                            use="required" />
                        <xs:attribute
                            name="OVERWRITE"
                            type="xs:boolean" />
                        <xs:attribute
                            name="IGNORELINECKS"
                            type="xs:boolean"
                            default="false" />
                    </xs:complexType>
                </xs:element>
                <xs:element
                    name="INPUTRANGE"
                    minOccurs="0"
                    maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute
                            name="STARTADDRESS"
                            type="eAddr"
                            use="required" />
                        <xs:attribute
                            name="ENDADDRESS"
                            type="eAddr"
                            use="required" />
                        <xs:attribute
                            name="FILLGAPS"
                            type="xs:string"
                            use="optional" />
                    </xs:complexType>
                </xs:element>
                <xs:element
                    ref="MEM"
                    minOccurs="0"
                    maxOccurs="unbounded" />
            </xs:sequence>
            <xs:attribute
                name="TYPE"
                type="filetype"
                use="required" />
            <xs:attribute
                name="IGNORELINECKS"
                type="xs:boolean"
                default="false" />
            <xs:attribute
                name="NAME"
                type="xs:string"
                use="required" />
            <xs:attribute
                name="OVERWRITE"
                type="xs:boolean"
                default="false" />
            <!-- Introduced "MODE" attribute to read MDG hex file as it can be Little Endian or Big Endian / -->
            <xs:attribute
                name="MODE"
                type="mode"
                use="required" />
            <xs:attribute
                name="FILLPATTERN"
                type="xs:string"
                use="optional" />            
        </xs:complexType>
    </xs:element>
    <xs:element name="VDSIN">
        <xs:annotation>
            <xs:documentation>VDSIN Tag specifies to use variant coding.VCTRINFOBLKADDRESS has to be specified with
                vector infoblock address, the INFOBLOCKADDRESS has to be supplied with the infoblock address. The file
                is specified in the NAME field. The VCTRINFOLOG takes a filename as input where the vector table
                information is wriiten,it is an otional attribute.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element
                    ref="MEM"
                    minOccurs="0"
                    maxOccurs="unbounded" />
            </xs:sequence>
            <xs:attribute
                name="TYPE"
                type="filetype"
                use="required" />
            <xs:attribute
                name="IGNORELINECKS"
                type="xs:boolean"
                default="false" />
            <xs:attribute
                name="NAME"
                type="xs:string"
                use="required" />
            <xs:attribute
                name="VCTRINFOBLKADDRESS"
                type="exhexBinary"
                use="optional" />
            <xs:attribute
                name="INFOBLOCKADDRESS"
                type="exhexBinary"
                use="required" />
            <!-- Removed from Version 3.1.1.0 as not used /> <xs:attribute name="MODE" type="mode" default="LittleEndian"/ -->
        </xs:complexType>
    </xs:element>
    <xs:element name="FILEOUT">
        <xs:annotation>
            <xs:documentation>FILEOUT has to be used for writing files in format specified in TYPE attribute. This can
                also support writing range output by supplying FROM and LEN. The IGNORE3OR5 specifies whether the record
                03 and 05 have to be ignored or not.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence minOccurs="0">
                <xs:element
                    ref="RANGE"
                    minOccurs="0"
                    maxOccurs="unbounded" />
            </xs:sequence>
            <xs:attribute
                name="TYPE"
                type="filetype"
                use="required" />
            <xs:attribute
                name="NAME"
                type="xs:string"
                use="required" />
            <xs:attribute
                name="FROM"
                type="exhexBinary" />
            <xs:attribute
                name="LEN"
                type="exhexBinary" />
            <xs:attribute
                name="IGNORE3OR5"
                type="xs:boolean"
                default="false" />

            <xs:attribute
                name="SORT"
                type="xs:boolean"
                use="optional"
                default="true" />

            <xs:attribute
                name="LYT"
                type="exFillBinary"
                use="optional"
                default="0x00">
                <xs:annotation>
                    <xs:documentation>to add LINE LENGTH feature FileOut-Tag: e.g. lineLength[0...255] 0 -&gt; output
                        identical to input (default) 1...255 -&gt; line length as given</xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute
                name="FORMAT"
                type="formattype"
                use="optional" />
            <xs:attribute
                name="FILLPATTERN"
                type="xs:string"
                use="optional" />      
            <xs:attribute
                name="RWG"
                type="xs:string"
                use="optional" />      
        </xs:complexType>
    </xs:element>
    <xs:element name="RANGE">
        <xs:annotation>
            <xs:documentation>RANGE element shall be used for merging or appending several range data into single file.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute
                name="FROM"
                type="exhexBinary"
                use="required" />
            <xs:attribute
                name="LEN"
                type="exhexBinary"
                use="required" />
        </xs:complexType>
    </xs:element>
    <xs:element name="VDSBACK">
        <xs:annotation>
            <xs:documentation>VDSBACK has to be used when VDS Backward coding is required. The TYPE is supplied with the
                type of file IHEX or S19.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute
                name="TYPE"
                type="filetype"
                use="required" />
            <xs:attribute
                name="NAME"
                type="xs:string"
                use="required" />
            <xs:attribute
                name="VDSLOG"
                type="xs:string"
                use="optional" />
            <xs:attribute
                name="VCTRINFOBLKADDRESS"
                type="exhexBinary"
                use="optional" />
            <xs:attribute
                name="INFOBLOCKADDRESS"
                type="exhexBinary"
                use="required" />
            <xs:attribute
                name="FILLVALUE"
                type="xs:string"
                use="optional" />
            <!-- Removed from Version 3.1.1.0 as not used /> <xs:attribute name="MODE" type="mode" default="LittleEndian"/ -->
        </xs:complexType>
    </xs:element>
    <xs:element name="HEXMOD">
        <xs:annotation>
            <xs:documentation>Hexmod Tag is the basic tag for all the modules.This tag always comes after CONF tag. It
                represents the following content is for Hexmod tool to process
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element
                    ref="ERRMOD"
                    minOccurs="0" />
                <xs:element ref="BASEIO" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="INPUT">
        <xs:annotation>
            <xs:documentation>INPUT is used to specify the list of files to be read and merged.</xs:documentation>
        </xs:annotation>
        <xs:complexType>        
            <xs:sequence>                
                <xs:choice>
                    <xs:element
                        ref="FILEIN"
                        maxOccurs="unbounded" />
                    <xs:element ref="VDS" />
                </xs:choice>
                <xs:element
                    ref="FILLGAPS"
                    minOccurs="0"
                    maxOccurs="unbounded" />
                <xs:element
                    name="FILLRANGE"
                    minOccurs="0"
                    maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute
                            name="START"
                            type="eAddr"
                            use="required" />
                        <xs:attribute
                            name="LEN"
                            type="eAddr"
                            use="required" />
                        <xs:attribute
                            name="FILLPATTERN"
                            type="xs:string"
                            use="optional" />
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
             <xs:attribute
                name="RWG_FILE"
                type="xs:string"
                use="optional" />
        </xs:complexType>
    </xs:element>
    <xs:element name="VDS">
        <xs:annotation>
            <xs:documentation>VDS Tag should be used ofr VDSCoding technique.It has a attribute VDSLOG which takes name
                of a file to which the details of the data sizes have to be written.VCTRTABLELOG takes a filename as a
                input to which vector table of data set and variant data sets are written. It contains a mandatory child
                element called VDSIN.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element
                    ref="VDSIN"
                    minOccurs="2"
                    maxOccurs="unbounded" />
            </xs:sequence>
            <xs:attribute
                name="VDSLOG"
                type="xs:string"
                use="optional" />
            <xs:attribute
                name="VCTRTABLELOG"
                type="xs:string"
                use="optional" />
            <xs:attribute
                name="VCTRINFOLOG"
                type="xs:string"
                use="optional">
                <xs:annotation>
                    <xs:documentation>generates the vector table infoblock file.</xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="action">
        <xs:restriction base="xs:string">
            <xs:enumeration value="COPY" />
            <xs:enumeration value="DEL" />
            <xs:enumeration value="MOVE" />
        </xs:restriction>
    </xs:simpleType>
    <xs:element name="MEM">
        <xs:annotation>
            <xs:documentation>MEM tag is to be used for all memory ralated actions.The ACTION should be given one of the
                following: COPY,DEL or MOVE. The FROM is supplied with the address, LEN is supplied with the length of
                the data. TO is supplied with the destination address. FILLGAPS specifies the fillgaps value. OVERWRITE
                specifies whether the data has to be overwritten or not.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute
                name="ACTION"
                type="action"
                use="required" />
            <xs:attribute
                name="FROM"
                type="exhexBinary"
                use="required" />
            <xs:attribute
                name="LEN"
                type="exhexBinary"
                use="required" />
            <xs:attribute
                name="TO"
                type="exhexBinary"
                use="optional" />
            <xs:attribute
                name="FILLGAPS"
                type="xs:string"
                use="optional" />
            <xs:attribute
                name="OVERWRITE"
                type="xs:boolean"
                default="false" />
            <xs:attribute
                name="NAME"
                type="xs:string"
                use="optional" />
            <xs:attribute
                name="TYPE"
                type="xs:string"
                use="optional" />
            <xs:attribute
                name="IGNORELINECKS"
                type="xs:boolean"
                default="false" />
        </xs:complexType>
    </xs:element>
    <xs:element name="LOG">
        <xs:annotation>
            <xs:documentation>LOG Tag is used to specify the Log file name in the FILE attribute.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute
                name="FILE"
                type="xs:string"
                use="required" />
        </xs:complexType>
    </xs:element>
    <xs:element name="MSGCONSOLE">
        <xs:annotation>
            <xs:documentation>MSGCONSOLE is the level which has to be logged to the console - 1 stands for INFO,2 stands
                for WARNING,3 stands for error.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute
                name="LVL"
                type="exLvl"
                use="required" />
        </xs:complexType>
    </xs:element>
    <xs:element name="MSGLOG">
        <xs:annotation>
            <xs:documentation>MSGLOG is the level which has to be logged to the log file - 1 stands for INFO,2 stands
                for WARNING,3 stands for error.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute
                name="LVL"
                type="exLvl"
                use="required" />
        </xs:complexType>
    </xs:element>
    <xs:element name="OUTPUT">
        <xs:annotation>
            <xs:documentation>The OUTPUT tag has to be used while writing output. This can have one of the following
                elemnets -
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:choice>
                <xs:element
                    ref="FILEOUT"
                    maxOccurs="unbounded" />
                <xs:element ref="VDSBACK" />
            </xs:choice>
        </xs:complexType>
    </xs:element>
    <xs:element name="PROGABORT">
        <xs:annotation>
            <xs:documentation>PROGABORT is the level which exits the program - 2 stands for WARNING,3 stands for error.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute
                name="LVL"
                type="exLvl2"
                use="required" />
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="filetype">
        <xs:restriction base="xs:string">
            <xs:enumeration value="S19" />
            <xs:enumeration value="IHEX" />
            <xs:enumeration value="BIN" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="formattype">
        <xs:restriction base="xs:string">
            <xs:enumeration value="S2" />
            <xs:enumeration value="S3" />
        </xs:restriction>
    </xs:simpleType>
    <!-- Removed from Version 3.1.1.0 as not used /> <xs:simpleType name="layout"> <xs:restriction base="xs:string"> <xs:maxLength 
        value="4"/> <xs:minLength value="3"/> <xs:pattern value="[0]x[1-2][a-fA-F0-9]"/> </xs:restriction> </xs:simpleType -->
    <xs:simpleType name="exhexBinary">
        <xs:restriction base="xs:string">
            <xs:maxLength value="10" />
            <xs:minLength value="3" />
            <xs:pattern value="[0]x[a-fA-F0-9]*" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="exLvl">
        <xs:restriction base="xs:unsignedByte">
            <xs:minInclusive value="1" />
            <xs:maxInclusive value="4" />
        </xs:restriction>
    </xs:simpleType>
    <!-- Introduced this attribute to read MDG hex file as it can be Little Endian or Big Endian/ -->
    <xs:simpleType name="mode">

        <xs:union>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="BigEndian" />
                    <xs:enumeration value="LittleEndian" />
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:pattern value="[Bb][Ii][Gg][Ee][Nn][Dd][Ii][Aa][Nn]" />
                    <xs:pattern value="[Ll][Ii][Tt][Tt][Ll][Ee][Ee][Nn][Dd][Ii][Aa][Nn]" />
                </xs:restriction>
            </xs:simpleType>
        </xs:union>
    </xs:simpleType>
    <xs:element name="FILLGAPS">
        <xs:annotation>
            <xs:documentation>FILLGAPS Tag contains the attributes START,LEN and FILLPATTERN. This range is filled with
                the Pattern specified on finding any Gap.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute
                name="START"
                type="eAddr"
                use="required" />
            <xs:attribute
                name="LEN"
                type="eAddr"
                use="required" />
            <xs:attribute
                name="FILLPATTERN"
                type="xs:string"
                use="optional" />
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="exLvl2">
        <xs:restriction base="xs:unsignedByte">
            <xs:minInclusive value="2" />
            <xs:maxInclusive value="3" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="eAddr">
        <xs:restriction base="xs:string">
            <xs:maxLength value="10" />
            <xs:minLength value="3" />
            <xs:pattern value="[0]x[a-fA-F0-9]*|MAXADDRESS|MINADDRESS" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="exFillBinary">
        <xs:annotation>
            <xs:documentation>to have values from 0x0 to 0xFF</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:maxLength value="4" />
            <xs:minLength value="4" />
            <xs:pattern value="[0]x[a-fA-F0-9]*" />
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
