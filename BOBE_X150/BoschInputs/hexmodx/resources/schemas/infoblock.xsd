  <xs:element name="MULTILINK">
    <xs:annotation>
      <xs:documentation>MULTILINK Tag is used to provide multilink infoblock start address in MDG2.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="START"
                    type="exhexBinary"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="BLKBUILD">
    <xs:annotation>
      <xs:documentation>BLKBUILD Tag is used when a linked file is provided in the input file list. It has a START attribute which requires the start of the infoblocks as the input.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="START"
                    type="exhexBinary"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="BLKLINK">
    <xs:annotation>
      <xs:documentation>BLKLINK Tag is used when blocks have to be linked. It conatins two atributes START and NXTBLK,these have to be provided with addresses. START will be linked to the NXKBLK</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="START"
                    type="exhexBinary"
                    use="required" />
      <xs:attribute name="NXTBLK"
                    type="exhexBinary"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="CHECKSUM">
    <xs:annotation>
      <xs:documentation>CHECKSUM Tag is used to update checksums and compatibility of infoblocks. It has two elements WRITECKS and COMPATIBILITY.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="WRITECKS"
                    minOccurs="0" />
        <xs:element ref="COMPATIBILITY"
                    minOccurs="0" />
      </xs:sequence>
      <xs:attribute name="WARNOVERWRITE"
                    type="xs:boolean"
                    use="optional"
                    default="true" />
    </xs:complexType>
  </xs:element>
  <xs:element name="CKLOG">
    <xs:annotation>
      <xs:documentation>CKLOG Tag is used to LOG checksum block information to a file specified in the FILE attribute of this tag.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="FILE"
                    type="xs:string"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="COMPATIBILITY">
    <xs:annotation>
      <xs:documentation>COMPATIBILITY Tag is used to update compatibility of infoblocks. It contains FUNCTION attribute which sets or checks based on the value asssigned to this attribute.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="IB"
                    minOccurs="0" maxOccurs="unbounded" />
        <xs:element ref="BLOCK"
                    minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
       <xs:attribute name="RESET"
                    type="xs:boolean"
                    use="optional"
                    default="false" />
      <xs:attribute name="FUNCTION"
                    type="action"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="CONF">
    <xs:annotation>
      <xs:documentation>CONF Tag is the root of all tags.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="HEXMOD" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ENDPATTERN">
    <xs:annotation>
      <xs:documentation>ENDPATTERN Tag is used to update Endpattern. It sets or checks on the existing value depending on the value assigned to the FUNCTION attribute.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="FUNCTION"
                    type="action"
                    use="required" />
    </xs:complexType>
  </xs:element>

  <xs:element name="HEXMOD">
    <xs:annotation>
      <xs:documentation>Hexmod Tag is the basic tag for all the modules.This tag always comes after CONF tag. It represents the following content is for Hexmod tool to process</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ERRMOD"
                    minOccurs="0" />
        <xs:element ref="IBMOD" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="IB">
    <xs:annotation>
      <xs:documentation>IB Tag is used to specify the main infoblock and its dependent infoblock . This updates based on the FUNCTION attribute in the COMPATIBILITY Tag.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="BLKADDR"
                    type="exhexBinary"
                    use="required" />
      <xs:attribute name="DEPBLKADDR"
                    type="exhexBinary"
                    use="required" />
    </xs:complexType>
  </xs:element>
   <xs:element name="BLOCK"> <!--  Introduced for GSTC -->
    <xs:annotation>
      <xs:documentation>BLOCK Tag is used to specify the block address where CompId and CompRef values are updated. Value can be IHEX or ASCII.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="START"
                    type="exhexBinary"
                    use="required" />
      <xs:attribute name="COMPID"
                    type="xs:string"
                    use="required" />
      <xs:attribute name="COMPREF"
                    type="xs:string"
                    use="required" />
      <xs:attribute
                    name="TYPE"
                    type="TYPE"
                    use="required" />                  
    </xs:complexType>
  </xs:element>
  <xs:element name="IBBUILD">
    <xs:annotation>
      <xs:documentation>IBBUILD Tag is used to specify infoblock information. This tag also follows IBMOD. It can contain only one of the following tags,either BLKBUILD or BLKLINK.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice>
        <xs:element ref="BLKBUILD" />
        <xs:element ref="BLKLINK"
                    maxOccurs="unbounded" />
        <xs:element ref="MULTILINK"/>
      </xs:choice>
      <!--  Introduced for GSTC -->
      <xs:attribute name="DIVISION" 
                    type="xs:string"
                    use="optional" />
    </xs:complexType>
  </xs:element>
  <xs:element name="IBLOG">
    <xs:annotation>
      <xs:documentation>IBLOG Tag is used to LOG infoblock information to a file specified in the FILE attribute of this tag.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="FILE"
                    type="xs:string"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="IBMOD">
