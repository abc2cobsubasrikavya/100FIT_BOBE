			<xs:attribute name="BLKID" type="blkId" use="required"/>
			<xs:attribute name="IGNORE_ERR" type="xs:boolean" use="required"/>
			<xs:attribute name="IGNORE_RELINK" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
        <xs:element ref="VALIDATE"
                    minOccurs="0" />
        <xs:element ref="LOGAFTER"
                    minOccurs="0" />
      </xs:sequence>
      <xs:attribute name="MDGTYPE" type="MdgType" use="optional" />
      <xs:attribute name="DISABLE_CHECKSUM_FOR_DATA_LEN_ZERO" type="xs:boolean" use="optional" default="false" />
    </xs:complexType>
  </xs:element>
  <xs:element name="LOGAFTER">
    <xs:annotation>
      <xs:documentation>LOGAFTER Tag is used to log infoblock information to a file after all processing of infoblock. It is an optional element. It can contain two elements IBLOG and CKLOG.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:all>
        <xs:element ref="IBLOG"
                    minOccurs="0" />
        <xs:element ref="CKLOG"
                    minOccurs="0" />
      </xs:all>
      <xs:attribute name="NUTZDATEN_CHECKSUM"
                   type="xs:string"
                   use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="LOGBEFORE">
    <xs:annotation>
      <xs:documentation>LOGBEFORE Tag is used to log infoblock information to a file before any processing of infoblock. It is an optional element. It can contain two elements IBLOG and CKLOG.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:all>
        <xs:element ref="IBLOG"
                    minOccurs="0" />
        <xs:element ref="CKLOG"
                    minOccurs="0" />
      </xs:all>
      <xs:attribute name="NUTZDATEN_CHECKSUM"
                   type="xs:string"
                   use="optional" />
    </xs:complexType>
  </xs:element>
  	<xs:element name="SWID">
		<xs:annotation>
			<xs:documentation>SWID is the Tag used to update SWID in the specified infoblock address in BLKADDR attribute. The Value is supplied in the VAL attribute. The function can be to set the value or test it on the existing information alraedy present,this is provided in the FUNCTION attribute.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="VAL" type="SWIDType" use="required"/>
			<xs:attribute name="BLKADDR" type="exhexBinary"/>
			<xs:attribute name="FUNCTION" type="action" use="required"/>
			<xs:attribute name="TYPE" type="swType" use="optional" default="ASCII"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="SWTTNR">
		<xs:annotation>
			<xs:documentation>SWTTNR is the Tag used to update SWTTNR in the specified infoblock address in BLKADDR attribute. The Value is supplied in the VAL attribute. The function can be to set the value or test it on the existing information alraedy present,this is provided in the FUNCTION attribute.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="VAL" type="SWTTNRType" use="required"/>
			<xs:attribute name="BLKADDR" type="exhexBinary"/>
			<xs:attribute name="FUNCTION" type="action" use="required"/>
            <xs:attribute name="FILE" type="xs:string" />
			<xs:attribute name="TYPE" type="swType" use="optional" default="ASCII"/>
		</xs:complexType>
	</xs:element>
  <xs:element name="VALIDATE">
    <xs:annotation>
      <xs:documentation>VALIDATE Tag is used for updating SWID,SWTTNR,ENDPATTERN and also writing checksums and compatibility.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>		
	<xs:element ref="SWID" minOccurs="0" maxOccurs="unbounded"/>
	<xs:element ref="SWTTNR" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="ENDPATTERN"
                    minOccurs="0" />
        <xs:element ref="CHECKSUM"
                    minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="WRITECKS">
    <xs:annotation>
      <xs:documentation>WRITECKS Tag is used to update checksums of infoblocks. It sets or checks on the existing value depending on the value assigned to the FUNCTION attribute.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="FUNCTION"
                    type="action"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="LOG">
    <xs:annotation>
      <xs:documentation>LOG Tag is used to specify the Log file name in the FILE attribute.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="FILE"
                    type="xs:string"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="MSGCONSOLE">
    <xs:annotation>
      <xs:documentation>MSGCONSOLE is the level which has to be logged to the console - 1 stands for INFO,2 stands for WARNING,3 stands for error.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="LVL"
                    type="exLvl"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="MSGLOG">
    <xs:annotation>
      <xs:documentation>MSGLOG is the level which has to be logged to the log file - 1 stands for INFO,2 stands for WARNING,3 stands for error.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="LVL"
                    type="exLvl"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="PROGABORT">
    <xs:annotation>
      <xs:documentation>PROGABORT is the level which exits the program - 2 stands for WARNING,3 stands for error.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="LVL"
                    type="exLvl2"
                    use="required" />
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="exLvl">
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="1" />
      <xs:maxInclusive value="4" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="exLvl2">
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="2" />
      <xs:maxInclusive value="3" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ERRMOD">
    <xs:annotation>
      <xs:documentation>ERRMOD contains information on the logging of messages to log file,logging of messages to console and aborting of the program</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="LOG" />
        <xs:element ref="MSGLOG"
                    minOccurs="0" />
        <xs:element ref="MSGCONSOLE"
                    minOccurs="0" />
        <xs:element ref="PROGABORT"
                    minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="action">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SET" />
      <xs:enumeration value="TEST" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="exhexBinary">
    <xs:restriction base="xs:string">
      <xs:maxLength value="10" />
      <xs:minLength value="3" />
      <xs:pattern value="[0]x[a-fA-F0-9]*" />
    </xs:restriction>
  </xs:simpleType>
  	<xs:simpleType name="SWIDType">
		<xs:restriction base="xs:string">
			<xs:pattern value="([\S\s]{8})|([0]x[0-9a-fA-F]{16})"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SWTTNRType">
		<xs:restriction base="xs:string">
			<xs:pattern value="([\S\s]{10})|([0]x[0-9a-fA-F]{20})"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="InfoblkDetails">
		<xs:restriction base="xs:string">
			<xs:maxLength value="10"/>
			<xs:minLength value="2"/>
			<xs:pattern value="[0]x[a-fA-F0-9]*|SB|TP|HSM0|HSM1|HSM2|HSM3|HSM4|HSM5|HSM6|HSM7|HSM8|HSM9|HSM10|HSM11|HSM12|HSM13|HSM14|HSM15|CTP|CB0|CB1|CB2|CB3|CB4|CB5|CB6|CB7|CB8|CB9|CB10|CB11|CB12|CB13|CB14|CB15|ASW0|ASW1|ASW2|ASW3|ASW4|ASW5|ASW6|ASW7|ASW8|ASW9|ASW10|ASW11|ASW12|ASW13|ASW14|ASW15|DS0|DS1|DS2|DS3|DS4|DS5|DS6|DS7|DS8|DS9|DS10|DS11|DS12|DS13|DS14|DS15|VDS|CUST0|CUST1|CUST2|CUST3|CUST4|CUST5|CUST6|CUST7|CUST8|CUST9|CUST10|CUST11|CUST12|CUST13|CUST14|CUST15|ALL"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="blkId">
		<xs:restriction base="xs:string">
			<xs:maxLength value="10"/>
			<xs:minLength value="3"/>
			<xs:pattern value="[0]x[0-9a-zA-Z]*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="swType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="HEX"/>
			<xs:enumeration value="ASCII"/>
		</xs:restriction>
	</xs:simpleType>
    <xs:simpleType name="TYPE">
        <xs:annotation>
            <xs:documentation>This type is used as an enumeration for TYPE identifier for CompId and CompRef values.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="IHEX" />
            <xs:enumeration value="ASCII" />            
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="MdgType">
        <xs:annotation>
            <xs:documentation>MDG type is to identify MDG platform </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="MDG1" />
            <xs:enumeration value="mdg1" />
            <xs:enumeration value="MDG2" />
            <xs:enumeration value="mdg2" />            
        </xs:restriction>
    </xs:simpleType>  

  
    <xs:element name="VRTE">
    <xs:annotation>
      <xs:documentation>VRTE tag indicates that it contains VRTE blocks information .</xs:documentation>
    </xs:annotation>
    <xs:complexType>
         <xs:attribute name="METADATA_FILE"
                    type="xs:string"
                    use="required" />
    </xs:complexType>
  </xs:element>
    
</xs:schema>
