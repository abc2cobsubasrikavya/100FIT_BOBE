    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:choice>
          <xs:element ref="IBBUILD" />
          <xs:element ref="VRTE"/>
        </xs:choice>
        <xs:element ref="LOGBEFORE"
                    minOccurs="0" />
	<xs:element name="DETAILEDLOG" minOccurs="0" maxOccurs="unbounded">
