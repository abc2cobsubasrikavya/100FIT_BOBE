			<xs:attribute name="FILE" type="xs:string" use="required"/>
			<xs:attribute name="INFOBLOCK" type="InfoblkDetails" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="INFOTABLELOG" minOccurs="0" maxOccurs="unbounded">
		<xs:complexType>			
			<xs:attribute name="FILE" type="xs:string" use="required"/>
			<xs:attribute name="INFOBLOCK" type="InfoblkDetails" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="DELETEBLOCK" minOccurs="0" maxOccurs="unbounded">
