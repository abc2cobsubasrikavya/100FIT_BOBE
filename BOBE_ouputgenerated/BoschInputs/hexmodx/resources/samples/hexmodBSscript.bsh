import com.bosch.hexmodx.hexInterfaces.IHexDataInterface;
import com.bosch.hexmodx.hexmodel.HexObjectFactory;
import com.bosch.hexmodx.formatters.IntelFormatter;

import com.bosch.hexmodx.parsers.IntelHexFileParser;
import com.bosch.hexmodx.serializers.HexmodXSerializer;
	   
		
		IHexDataInterface hexObject = HexObjectFactory.createHexObject();
		
		IntelHexFileParser hexFileParser = new IntelHexFileParser();

		hexFileParser.parse(hexObject,"medc18.hex",true);	
       
		hexObject.MemCopy("0x80000000", 0x10, "0x80010000",true,"0xFF");
   		
		IntelFormatter Formatter= new IntelFormatter();
		
		HexmodXSerializer hexFileSerializer = new HexmodXSerializer(hexObject,Formatter);
	
		
		hexFileSerializer.serialize("medc18_out.hex");
		
		
	
        