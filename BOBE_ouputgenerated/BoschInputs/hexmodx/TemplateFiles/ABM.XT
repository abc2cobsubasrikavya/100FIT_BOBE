<?xml version="1.0" encoding="UTF-8"?>
<CONF xmlns="www.rbin.com/mds-1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="www.rbin.com/mds-1
.\schemas\abm.xsd">
<!-- This is the input to the abm dll -->
	<HEXMOD>
		<ABMMOD##DEVICE_TYPE##>
			<!-- Here the addresses of ABM are mentioned -->
			##ABM_ADDRESS_BLOCK##			
		</ABMMOD>
		
		##BMI_ADDRESS_BLOCK##
		
	</HEXMOD>
</CONF>